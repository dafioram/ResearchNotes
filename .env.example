# Copy this file to .env and adjust as needed.
# `cp .env.example .env`

# Port the app listens on. Used both by run.py and by docker-compose.yml
# (for the host<->container port mapping).
PORT=5000

# Interface to bind to. Leave as 0.0.0.0 for Docker. For running run.py
# directly on your own machine, 0.0.0.0 also works, or use 127.0.0.1 to
# only accept connections from this machine.
HOST=0.0.0.0

# Optional: fixes the Flask session/flash-message signing key across
# restarts. Not required for a single-user, no-auth setup -- if left
# blank, a random key is generated each time the process starts (flash
# messages just won't survive a restart mid-request, which is harmless).
SECRET_KEY=

# Notes per page on the feed, Orphans and Attachments views. Default 50.
PAGE_SIZE=50

# Docker only: your time zone, so dates (a new note's default sort date,
# deletion dates in Trash) are local rather than UTC. Running run.py
# directly already uses your computer's time zone and ignores this.
# TZ=America/New_York

# Optional: where the SQLite database and uploaded file store live.
# Defaults to a "data" folder next to this file.
# DATA_DIR=./data
